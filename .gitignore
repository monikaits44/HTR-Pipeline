# =============================================================================
# HTR-Pipeline .gitignore  (publication profile — iteration 2, 2026-09-09)
# =============================================================================
# Publication surface (what is TRACKED and pushed to GitHub):
#     README.md, LICENSE, CITATION.cff, COMMIT_GUIDE.md, requirements.txt,
#     .gitignore, models.py, configs/, utils/, synthetic_data_generation/,
#     docs/README.md,
#     notebook/beyond_memorization_attention_maps.ipynb (the "main" notebook),
#     outputs/  (curated report-outline figures + booklet_attention_preview.gif)
#
# Everything else — including all raw datasets, checkpoints, SLURM launchers,
# analysis notes, exploratory notebooks, third-party clones, and the
# workspace-local archive/ — is preserved on disk but NOT tracked in Git.
# =============================================================================

# ---- Python / Jupyter ---------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
pip-wheel-metadata/
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---- Environments ------------------------------------------------------------
.venv/
venv/
env/
.env
.envrc

# ---- IDE / OS ----------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.swn
.DS_Store
Thumbs.db

# ---- LaTeX build artefacts ---------------------------------------------------
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.synctex.gz
*.fdb_latexmk
*.fls
*.nav
*.snm
*.vrb

# ---- Publication policy (iteration 2) ----------------------------------------
# Everything listed below is preserved locally under archive/ or in its
# original location but is not published to GitHub.
archive/
asset/
data/
evaluation_execution/logs/
experiments_execution/
external/
logs/
saved_models/
scripts/
documents/backup_documents
# Root-level artefacts that live only in the workspace ------------------------
letter2index.json
index2letter.json
FINAL_EXPERIMENTS.md

# ---- Synthetic-data pipeline runtime artefacts -------------------------------
# The pipeline code IS tracked, but the large images/LMDBs it produces are not.
synthetic_data_generation/synthesized_images/
synthetic_data_generation/*.lmdb
synthetic_data_generation/*/data.mdb
synthetic_data_generation/*/lock.mdb

# ---- Loose datasets / SLURM outputs at any level (defensive) -----------------
datasets/
slurm-*.out
slurm-*.err

# ---- Secrets / credentials ---------------------------------------------------
*.pem
*.key
*.env.local
secrets/
credentials/
.aws/
.ssh/

# ---- Miscellaneous transient files -------------------------------------------
*.tmp
*.bak
*.old
*.orig
*~
core
core.*
archive/*